<Window x:Class="MediaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Movie Scanner" Height="900" Width="1400"
                WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel>

        <!-- Barre d'outils en haut -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{DynamicResource MaterialDesignPrimary}" Height="50">
            <Button Content="Ajouter un chemin"
                    Margin="10,5"
                    Padding="10,5"
                    Foreground="Black"
                    FontWeight="SemiBold"
                    Background="{DynamicResource MaterialDesignSecondaryAccentBrush}"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            <Button Content="Scanner"
                    Margin="5,5"
                    Padding="10,5"
                    Foreground="Black"
                    FontWeight="SemiBold"
                    Background="{DynamicResource MaterialDesignSecondaryAccentBrush}"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            <Button Content="Quitter"
                    Margin="5,5"
                    Padding="10,5"
                    Foreground="Black"
                    FontWeight="SemiBold"
                    Background="{DynamicResource MaterialDesignSecondaryAccentBrush}"
                    Style="{StaticResource MaterialDesignFlatButton}" />
        </StackPanel>

        <!-- Contenu principal -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <!-- Liste à gauche -->
                <ColumnDefinition Width="*" />
                <!-- Détail à droite -->
            </Grid.ColumnDefinitions>

            <!-- Liste de films -->
            <ListBox x:Name="MoviesList"
                     ItemsSource="{Binding Movies}"
                     SelectedItem="{Binding SelectedMovie, Mode=TwoWay}"
                     Background="{DynamicResource MaterialDesignCardBackground}"
                     BorderThickness="0"
                     Foreground="{DynamicResource MaterialDesignBody}"
                     FontSize="12"
                     Margin="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="30">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignSecondaryBrush}" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Détails du film -->
            <materialDesign:Card Grid.Column="1" Margin="20" Padding="20" DataContext="{Binding SelectedMovie}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Margin="0,0,0,5" />
                    <TextBlock Text="{Binding Year}" FontSize="14" Foreground="Gray" Margin="0,0,0,15" />
                    <Image Source="{Binding PosterPath}" Height="250" Stretch="Uniform" Margin="0,0,0,15" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" FontSize="12" />
                    </ScrollViewer>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </DockPanel>
</Window>