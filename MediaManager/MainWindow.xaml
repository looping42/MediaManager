<Window x:Class="MediaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Movie Scanner" Height="600" Width="1000"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Liste de films -->
        <ListBox x:Name="MoviesList"
         ItemsSource="{Binding Movies}"
         SelectedItem="{Binding SelectedMovie, Mode=TwoWay}"
         Background="{DynamicResource MaterialDesignCardBackground}"
         BorderThickness="0"
         Foreground="{DynamicResource MaterialDesignBody}"
         FontSize="14"
         Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Image Source="{Binding PosterPath}" Height="40" Width="27" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Width="160" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="Margin" Value="1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesignSecondaryBrush}" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Détails du film -->
        <materialDesign:Card Grid.Column="1" Margin="20" Padding="20" DataContext="{Binding SelectedMovie}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Year}" FontSize="16" Foreground="Gray" Margin="0,0,0,20" />
                <Image Source="{Binding PosterPath}" Height="300" Stretch="Uniform" Margin="0,0,0,20" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" FontSize="14" />
                </ScrollViewer>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>