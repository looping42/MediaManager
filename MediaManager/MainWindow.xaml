<Window x:Class="MediaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Movie Scanner" Height="900" Width="1400"
                WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel>
        <Grid x:Name="LoadingOverlay"
      Background="#AA000000"
      Visibility="Collapsed"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🔄 Scan en cours..."
                   Foreground="White"
                   FontSize="20"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10" />
                <ProgressBar IsIndeterminate="True" Width="200" Height="20" />
            </StackPanel>
        </Grid>
        <!-- Menu at the top -->
        <Menu DockPanel.Dock="Top" Background="#EEE" Height="30">
            <MenuItem Header="_File">
                <MenuItem Header="_New" />
                <MenuItem Header="_Open..." />
                <Separator />
                <MenuItem Header="_Exit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" />
                <MenuItem Header="_Redo" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" />
            </MenuItem>
        </Menu>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="SearchBox"
                 VerticalAlignment="Center"
                 Width="300"
                 materialDesign:HintAssist.Hint="Rechercher un film..."
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Padding="30,2,5,2"
                 TextChanged="SearchBox_TextChanged" />

            <Button Content="Scanner"
                Padding="10,5"
                Width="300"
                            Command="{Binding ScanMoviesCommand}"
                Foreground="Black"
                Background="{DynamicResource MaterialDesignSecondaryAccentBrush}"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>

        <TabControl>
            <!-- Premier onglet : Films -->
            <TabItem Header="Films">
                <!-- Contenu principal -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <!-- Liste à gauche -->
                        <ColumnDefinition Width="*" />
                        <!-- Détail à droite -->
                    </Grid.ColumnDefinitions>

                    <!-- Liste de films -->
                    <ListBox x:Name="MoviesList"
                     ItemsSource="{Binding Movies}"
                     SelectedItem="{Binding SelectedMovie, Mode=TwoWay}"
                     Style="{StaticResource MaterialDesignListBox}"
                     Background="{DynamicResource MaterialDesignCardBackground}"
                     BorderThickness="0"
                     Foreground="{DynamicResource MaterialDesignBody}"
                     FontSize="12"
                     Margin="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />
                                        <!-- Colonne pour le titre -->
                                    </Grid.ColumnDefinitions>
                                    <!-- Titre du film -->
                                    <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="10,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <ScrollViewer Grid.Column="1" Margin="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                        <!-- Détails du film -->
                        <materialDesign:Card Margin="20" Padding="20" DataContext="{Binding SelectedMovieNfo}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <!-- Affiche -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Infos -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Vertical">
                                    <!-- Poster -->
                                    <TextBlock Text="Poster" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Thumbs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Url}" Height="350" Stretch="Uniform" Margin="0,0,0,15"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Fanart -->
                                    <TextBlock Text="Fanart" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Fanart.Thumbs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding}" Height="150" Stretch="UniformToFill" Margin="0,0,0,10"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>


                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <!-- Titre principal -->
                                    <TextBlock Text="{Binding Title}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />

                                    <!-- Sous-titre -->
                                    <TextBlock Text="{Binding OriginalTitle}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource MaterialDesignBodyMediumBrush}"
                                   Margin="0,0,0,10" />

                                    <!-- Année et durée -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Year}" FontWeight="Bold" />
                                        <TextBlock Text=" • " Margin="5,0" />
                                        <TextBlock Text="{Binding Runtime, StringFormat={}{0} min}" />
                                    </StackPanel>

                                    <!-- Notes -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="Star" Foreground="Gold" Width="18" Height="18" />
                                        <TextBlock Text="{Binding Ratings[0].Value, StringFormat={}{0}/10}" FontWeight="Bold" Margin="5,0" />
                                        <TextBlock Text="  (IMDb)" Foreground="Gray" VerticalAlignment="Bottom" />
                                    </StackPanel>

                                    <!-- Genres -->
                                    <WrapPanel>
                                        <ItemsControl ItemsSource="{Binding Genres}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="15"
                                    Background="{DynamicResource MaterialDesignPaperBrush}"
                                    Margin="2"
                                    Padding="6,2">
                                                        <TextBlock Text="{Binding}" FontSize="12" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>

                                    <!-- Résumé -->
                                    <TextBlock Text="Résumé :" FontWeight="Bold" Margin="0,15,0,5" />
                                    <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding Plot}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource MaterialDesignBodyMediumBrush}" />
                                    </ScrollViewer>

                                    <!-- Réalisateurs -->
                                    <TextBlock Text="Réalisateurs :" FontWeight="Bold" Margin="0,15,0,5" />
                                    <ItemsControl ItemsSource="{Binding Directors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, StringFormat=• {0}}" FontSize="13" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Acteurs -->
                                    <TextBlock Text="Acteurs principaux :" FontWeight="Bold" Margin="0,15,0,5" />
                                    <ItemsControl ItemsSource="{Binding Actors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, StringFormat=• {0}}" FontSize="13" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- second onglet : Films -->
            <TabItem Header="Films non identifée">
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>