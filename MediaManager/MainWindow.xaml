<Window x:Class="MediaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Movie Scanner" Height="900" Width="1400"
                WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel>
        <!-- Menu at the top -->
        <Menu DockPanel.Dock="Top" Background="#EEE" Height="30">
            <MenuItem Header="_File">
                <MenuItem Header="_New" />
                <MenuItem Header="_Open..." />
                <Separator />
                <MenuItem Header="_Exit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" />
                <MenuItem Header="_Redo" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" />
            </MenuItem>
        </Menu>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="SearchBox"
                 VerticalAlignment="Center"
                 Width="300"
                 materialDesign:HintAssist.Hint="Rechercher un film..."
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Padding="30,2,5,2"
                 TextChanged="SearchBox_TextChanged" />

            <Button Content="Scanner"
                Padding="10,5"
                Width="300"
                Click="ScanButton_Click"
                Foreground="Black"
                Background="{DynamicResource MaterialDesignSecondaryAccentBrush}"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>

        <TabControl>
            <!-- Premier onglet : Films -->
            <TabItem Header="Films">
                <!-- Contenu principal -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <!-- Liste à gauche -->
                        <ColumnDefinition Width="*" />
                        <!-- Détail à droite -->
                    </Grid.ColumnDefinitions>

                    <!-- Liste de films -->
                    <ListBox x:Name="MoviesList"
                     ItemsSource="{Binding Movies}"
                     SelectedItem="{Binding SelectedMovie, Mode=TwoWay}"
                     Style="{StaticResource MaterialDesignListBox}"
                     Background="{DynamicResource MaterialDesignCardBackground}"
                     BorderThickness="0"
                     Foreground="{DynamicResource MaterialDesignBody}"
                     FontSize="12"
                     Margin="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="50">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <!-- Colonne pour l'icône/poster -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Colonne pour le titre -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Icône / mini-poster -->
                                    <Image Source="{Binding PosterThumb}"
                                       Width="40" Height="50"
                                       Stretch="UniformToFill"
                                       Margin="5" />

                                    <!-- Titre du film -->
                                    <TextBlock Grid.Column="1"
                       Text="{Binding Title}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Margin="10,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Détails du film -->
                    <materialDesign:Card Background="{DynamicResource MaterialDesignCardBackground}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <!-- Poster -->
                                <ColumnDefinition Width="*" />
                                <!-- Infos -->
                            </Grid.ColumnDefinitions>

                            <!-- Poster -->
                            <Image Grid.Column="0" Source="{Binding PosterPath}" Height="400" Stretch="UniformToFill" Margin="0,0,15,0" />

                            <!-- Infos -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Année: " FontWeight="Bold" />
                                    <TextBlock Text="{Binding Year}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Durée: " FontWeight="Bold" />
                                    <TextBlock Text="{Binding Runtime}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="Genre: " FontWeight="Bold" />
                                    <TextBlock Text="{Binding Genre}" />
                                </StackPanel>

                                <TextBlock Text="Synopsis" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                                    <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" FontSize="14" />
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
            <!-- second onglet : Films -->
            <TabItem Header="Films non identifée">
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>