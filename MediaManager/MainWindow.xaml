<Window x:Class="MediaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movie Scanner"
        Height="900"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
        Icon="/icone.png">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="5"
            GlassFrameThickness="0"
            CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <!-- Root Grid -->
    <Grid Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <DockPanel>

            <!-- Barre supérieure -->
            <Border Background="{DynamicResource SystemAccentColorDarkBrush}" Height="50" DockPanel.Dock="Top">
                <DockPanel>
                    <TextBlock Text="🎬 Movie Scanner"
                               VerticalAlignment="Center"
                               Margin="16,0"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold" />

                    <!-- Actions à droite -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button ToolTip="Paramètres" Click="SettingsMenuItem_Click"
                                Background="Transparent" BorderBrush="Transparent">
                            <TextBlock Text="⚙" FontSize="16" Foreground="White" />
                        </Button>
                        <Button ToolTip="Quitter" Click="ExitMenuItem_Click"
                                Background="Transparent" BorderBrush="Transparent">
                            <TextBlock Text="✖" FontSize="16" Foreground="White" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Barre de recherche -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
                <TextBox x:Name="SearchBox"
                         VerticalAlignment="Center"
                         Width="250"
                         Height="35"
                         Margin="0,0,20,0"
                         Text="Rechercher un film..."
                         Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                         Padding="5" />

                <Button Content="Scanner"
                        Width="120"
                        Height="35"
                        Command="{Binding ScanMoviesCommand}"
                        Background="{DynamicResource SystemAccentColorBrush}"
                        Foreground="White" />

                <ProgressBar x:Name="ScanProgressBar"
                             Width="150"
                             Height="5"
                             Margin="15,0,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource SystemAccentColorBrush}" />
            </StackPanel>

            <!-- Log en bas -->
            <TextBox x:Name="ScanLogTextBox"
                     DockPanel.Dock="Bottom"
                     Height="200"
                     Margin="10"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                     Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

            <!-- Contenu principal -->
            <TabControl>
                <!-- Onglet Films -->
                <TabItem Header="Films">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Liste de films -->
                        <ListBox x:Name="MoviesList"
                                 ItemsSource="{Binding Movies}"
                                 SelectedItem="{Binding SelectedMovie, Mode=TwoWay}"
                                 Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Margin="10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Détails -->
                        <ScrollViewer Grid.Column="1" Margin="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="20" CornerRadius="8" DataContext="{Binding SelectedMovieNfo}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Poster & Fanart -->
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Poster" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                        <ItemsControl ItemsSource="{Binding Thumbs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Url}" Height="350" Stretch="Uniform" Margin="0,0,0,15" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Fanart" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5" />
                                        <ItemsControl ItemsSource="{Binding Fanart.Thumbs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding}" Height="150" Stretch="UniformToFill" Margin="0,0,0,10" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Infos principales -->
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding OriginalTitle}" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,10" />
                                        <TextBlock Text="{Binding Tagline}" FontStyle="Italic" Foreground="Gray" FontSize="13" Margin="0,0,0,10" />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Year}" FontWeight="Bold" />
                                            <TextBlock Text=" • " Margin="5,0" />
                                            <TextBlock Text="{Binding Runtime, StringFormat={}{0} min}" />
                                            <TextBlock Text=" • " Margin="5,0" />
                                            <TextBlock Text="{Binding Source}" />
                                            <TextBlock Text=" • " Margin="5,0" />
                                            <TextBlock Text="{Binding Countries[0]}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,15,0,10">
                                            <TextBlock Text="★" Foreground="Gold" FontSize="18" />
                                            <TextBlock Text="{Binding Notes, StringFormat={}{0:N1}/10}" FontWeight="Bold" Margin="5,0" />
                                            <TextBlock Text="{Binding Votes, StringFormat={} ({0} votes)}" Foreground="Gray" Margin="5,0" />
                                        </StackPanel>

                                        <!-- Genres -->
                                        <WrapPanel>
                                            <ItemsControl ItemsSource="{Binding Genres}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="15" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Margin="2" Padding="6,2">
                                                            <TextBlock Text="{Binding}" FontSize="12" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>

                                        <!-- Résumé -->
                                        <TextBlock Text="Résumé :" FontWeight="Bold" Margin="0,15,0,5" />
                                        <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding Plot}" TextWrapping="Wrap" FontSize="13" Foreground="Gray" />
                                        </ScrollViewer>

                                        <!-- Studios -->
                                        <TextBlock Text="Studios :" FontWeight="Bold" Margin="0,15,0,5" />
                                        <ItemsControl ItemsSource="{Binding Studios}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Vertical" ItemWidth="120" MaxHeight="220" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="13" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Réalisateurs -->
                                        <TextBlock Text="Réalisateurs :" FontWeight="Bold" Margin="0,15,0,5" />
                                        <ItemsControl ItemsSource="{Binding Directors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Vertical" ItemWidth="120" MaxHeight="220" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Acteurs -->
                                        <TextBlock Text="Acteurs principaux :" FontWeight="Bold" Margin="0,15,0,5" />
                                        <ItemsControl ItemsSource="{Binding Actors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Vertical" ItemWidth="120" MaxHeight="220" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Bande-annonce -->
                                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                            <TextBlock Text="🎬 Bande-annonce : " FontWeight="Bold" />
                                            <TextBlock>
                                                <Hyperlink NavigateUri="{Binding Trailer}" RequestNavigate="Hyperlink_RequestNavigate">
                                                    <Run Text="Ouvrir dans YouTube" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Onglet Films non identifiés -->
                <TabItem Header="Films non identifiés" />
            </TabControl>
        </DockPanel>
    </Grid>
</Window>